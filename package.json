{
  "name": "chat-server",
  "version": "0.2.0",
  "description": "Realtime chat server — channels, direct messages, presence, Socket.IO + Redis adapter",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "github:fwmakc/chat-server"
  },
  "keywords": [
    "nestjs",
    "websocket",
    "socket-io",
    "chat",
    "realtime"
  ],
  "bugs": {
    "url": "https://github.com/fwmakc/chat-server/issues"
  },
  "homepage": "https://github.com/fwmakc/chat-server#readme",
  "scripts": {
    "ai-context": "node node_modules/api-server-toolkit/scripts/generate-service-context.js",
    "build": "tsc -p tsconfig.build.json",
    "build:contracts": "tsc -p tsconfig.contracts.json",
    "dev": "nest start --watch",
    "prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --runInBand",
    "test:cov": "jest --coverage",
    "test:watch": "jest --watch",
    "migration:auto": "npm run typeorm migration:generate -- -d ./src/config/typeorm.config.ts ./src/typeorm/migrations/auto",
    "migration:create": "npm run typeorm migration:create --",
    "migration:fake": "npm run migration:run -- --fake",
    "migration:revert": "npm run typeorm migration:revert",
    "migration:run": "npm run typeorm migration:run -- -d ./src/config/typeorm.config.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.0.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@sentry/nestjs": "^10.69.0",
    "api-server-toolkit": "github:fwmakc/api-server-toolkit#v0.32.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.3.1",
    "event-server": "github:fwmakc/event-server#v1.6.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.1",
    "jwks-rsa": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.7.0",
    "typeorm": "^0.3.31",
    "typeorm-transactional": "^0.5.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.28",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.5.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0"
  },
  "exports": {
    "./contracts": "./dist/contracts/index.js"
  },
  "typesVersions": {
    "*": {
      "contracts": [
        "dist/contracts/index.d.ts"
      ]
    }
  }
}
