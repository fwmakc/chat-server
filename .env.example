NODE_ENV=development
IP=localhost
PORT=3004

# Postgres (schema is owned by migrations; applied on boot under a lock)
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=root
DB_PASSWORD=
DB_NAME=chat_server

# Auth server (JWT verification via JWKS on the WebSocket handshake)
AUTH_SERVER_URL=http://localhost:3001
# Optional JWT pinning (must match auth-server when set there)
JWT_ISSUER=
JWT_AUDIENCE=

# Redis (Socket.IO adapter, presence keys)
REDIS_URL=redis://localhost:6379

# Internal API key for service-to-service calls
INTERNAL_API_KEY=

# Event server (user.* subscription; set to "disabled" to opt out)
EVENT_SERVER_URL=http://localhost:3005
# Hostname the event-server should call back (defaults to os.hostname());
# WEBHOOK_URL overrides the whole callback URL
WEBHOOK_HOST=
WEBHOOK_URL=
# HMAC secret for webhook deliveries (X-Event-Signature)
WEBHOOK_SECRET=

# Chat limits
CHAT_MESSAGE_MAX_LEN=4096
CHAT_MESSAGE_MAX_ATTACHMENTS=10
# Per-socket event rate limits: <events>/<window seconds>
CHAT_RATE_MESSAGES=30/10
CHAT_RATE_JOINS=30/10
CHAT_RATE_TYPING=2/1
# Message retention in days; 0 or empty = keep forever
CHAT_MESSAGE_RETENTION_DAYS=0

# Documentation
SWAGGER_PREFIX=swagger
SWAGGER_PREFIX_REDOC=redoc
SWAGGER_TITLE=Chat Server API
SWAGGER_DESCRIPTION=Realtime chat server — channels, DMs, presence
SWAGGER_VERSION=1.0

# Infrastructure (optional)
SENTRY_DSN=
SENTRY_ENV=localhost

# Logging
MORGAN_LOG_FORMAT=dev
